{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "rules": [
            { "id": "aws-access-token", "properties": { "severity": "high" } }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-token",
          "level": "error",
          "message": { "text": "AWS Access Key detected" },
          "partialFingerprints": { "secret": "AKIA-TESTFIXTURE-0001" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "config/settings.py" },
                "region": { "startLine": 10 }
              }
            }
          ]
        }
      ]
    }
  ]
}
