{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "trivy",
          "rules": [
            { "id": "aws-access-token", "properties": { "severity": "high" } },
            { "id": "CVE-2099-0001", "properties": { "security-severity": "9.8" } }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-token",
          "level": "error",
          "message": { "text": "AWS Access Key detected" },
          "partialFingerprints": { "secret": "AKIA-TESTFIXTURE-0001" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "config/settings.py" },
                "region": { "startLine": 10 }
              }
            }
          ]
        },
        {
          "ruleId": "CVE-2099-0001",
          "level": "error",
          "message": { "text": "Critical RCE in libfoo < 2.0" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "requirements.txt" },
                "region": { "startLine": 3 }
              }
            }
          ]
        }
      ]
    }
  ]
}
